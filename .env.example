# Database Configuration
# Default for local standalone dev is SQLite.
# Docker Compose automatically overrides DATABASE_URL to PostgreSQL (postgresql://postgres:postgres@db:5432/expensetracker)
DATABASE_URL=sqlite:///./expensetracker.db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expensetracker

# Authentication
SECRET_KEY=super-secret-key-change-in-production-0987654321-expense-tracker
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend Configuration
VITE_API_URL=/api/v1
